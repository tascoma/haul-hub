# Frontend env vars (loaded by Vite). Copy to .env.local for dev (gitignored).
# In dev the Vite proxy already forwards /api/* to http://localhost:8000,
# so VITE_API_URL is optional. Set it in production to point at the deployed backend.
VITE_API_URL=

# Browser Google Maps key (Maps JavaScript API). Restrict by HTTP referrer in the
# Google Cloud console. Used to render the pickup/dropoff route and the browse map.
# When unset, maps are hidden and the app falls back to text addresses.
VITE_GOOGLE_MAPS_API_KEY=

# Stripe publishable key (pk_test_... for dev). Safe to expose in the browser.
# Get from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Platform fee in basis points — must match PLATFORM_FEE_BPS in the backend .env.
# Used to compute hauler payout estimates before a payment record exists.
VITE_PLATFORM_FEE_BPS=1000
